# Copy this file to ".env" and fill in your real values.
# Never commit your actual .env file -- it's already excluded in .gitignore.

# Your Bluesky handle, e.g. yourname.bsky.social
BLUESKY_HANDLE=

# An "app password" (NOT your main account password).
# Create one at: https://bsky.app/settings/app-passwords
BLUESKY_APP_PASSWORD=

# Used by agent.py to generate a natural-language summary of growth
# across topics. Get a key at: https://console.anthropic.com/
# Optional: agent.py still runs the fetch/chart/growth pipeline without
# it, it just skips the summary step.
ANTHROPIC_API_KEY=
