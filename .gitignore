# Secrets -- never commit your real Bluesky or Anthropic credentials
.env

# agent.py commits data/*.db, data/*.png, and data/agent_summary_log.txt
# itself (see commit_and_push_data() in agent.py) so historical data
# persists across runs even on ephemeral compute. The raw cron
# stdout/stderr redirect is local-only operational logging, not project
# data, so it's excluded here (along with the old run_pipeline.sh log).
data/pipeline.log
data/agent_cron.log

# Python virtual environment
venv/
.venv/

# Python cache files
__pycache__/
*.pyc

# sentiment_training/ is a separate learning exercise (see its own
# README) -- any data exported for convenience or intermediate trained
# model files shouldn't be committed. A finished model that's actually
# going to be used gets copied into the main project deliberately, by
# hand, not picked up automatically here.
sentiment_training/*.csv
sentiment_training/*.joblib
sentiment_training/*.pkl
